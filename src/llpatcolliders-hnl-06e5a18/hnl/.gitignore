output/
tmp/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# MadGraph transient build/run artifacts (run_wz_production.py).
# The per-point process dir is regenerated and removed on success; never commit it.
production/madgraph/work/
# MG5 also vendors its 148 MB install here if you choose the drop-in option.
vendored/MG5_aMC_v3_6_6/
# Legacy PLY parser caches from MG5 invocations. Current runners generate
# these inside tmp/cache, but ignore old checkout-root copies as well.
py.py
parser.out
# Pickled UFO model cache MG5 writes into a model dir on `import model`.
# Python-version-specific and regenerated on demand; the .py UFO sources are
# the tracked source of truth.
py3_model.pkl

# One-off analysis audit outputs (CSV/JSON snapshots). Not read by any code;
# regenerated by the audit scripts on demand.
audits/

# FONLL grid-generation tool. Lives in its own repo
# (github.com/leoredi/fonll-nnpdf40); only its central grid OUTPUTS are
# committed, under data/production/fonll/central/.
tools/fonll_nnpdf40/

# Editor / agent cruft and paper build artifact.
.cursor/
HNL_production.tex
HNL_production.pdf
